# ==============================================================================
# Jira MCP Server - Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL!
# ==============================================================================

# Base URL of your self-hosted or cloud Jira instance (trailing slash optional)
JIRA_URL=https://jira.example.com/

# Authentication Settings
# mechanism: 'bearer' (PAT) or 'basic' (username + password)
JIRA_AUTH_TYPE=bearer
JIRA_USERNAME=your_username
JIRA_PASSWORD=your_secure_password_or_token

# SSL Verification (set to false only in private test/staging environments)
JIRA_REJECT_UNAUTHORIZED=true

# Security Scope (comma-separated list, or '*' for all)
ALLOWED_PROJECTS=*
ALLOWED_TOOLS=*
